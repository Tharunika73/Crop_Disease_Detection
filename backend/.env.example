# Copy this file to .env and fill in real values before running.

SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./cropapp.db
# For production with Docker Compose, this is set automatically to Postgres.

WEATHER_API_KEY=
# Get a free key at https://openweathermap.org/api
# Leave blank to use simulated weather during local development.

MODEL_PATH=./ml/trained_model.h5
CLASS_NAMES_PATH=./ml/class_names.json
# Leave these pointing at files that don't exist yet to use the mock classifier.

UPLOAD_DIR=./uploads
CORS_ORIGINS_RAW=http://localhost:5173,http://localhost:3000
